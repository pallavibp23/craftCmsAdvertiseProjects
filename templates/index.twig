<!doctype html>
<html class="no-js" lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="{{siteUrl}}css/advertise.css" rel="stylesheet">
    <title>AARP | Media Advertising Network</title>
    <meta content="en_US" property="og:locale">
    <meta content="AARP Media Advertising Network" property="og:site_name">
    <meta content="website" property="og:type">
    <meta content="https://advertise.aarp.org/" property="og:url">
    <meta content="AARP | Media Advertising Network" property="og:title">
    <meta content="AARP Media Advertising Network connects you to a powerful audience through a array of advertising solutions. Reach a rep today to learn how AARP can help." property="og:description">
</head>

<body class="flex flex-col min-h-screen antialiased font-sans">
{% set entry = craft.entries.section('home').one() %}

<header class="main-header w-full z-50 fixed" x-data="{ mobileMenuOpen: false }">
    <div class="dropdown-bg bg-white z-10"></div>
    <div class="mx-auto max-w-7xl header-container">
        <div class="flex justify-between">
            <div class="pl-4 flex-shrink-0 w-auto mobile-menu">
                <button class="mobile-dropdown-button p-2" aria-label="Open mobile navigation" @click="mobileMenuOpen = ! mobileMenuOpen">
                    <div class="hamburger" :class="mobileMenuOpen ? 'open' : ''">
                        <span></span><span></span><span></span><span></span>
                    </div>
                </button>
            </div>
            <div class="main-logo pl-4 flex-shrink-0 w-auto z-20">
                <a class="block" href="/"><img src="https://advertise.aarp.org/assets/img/main-logo.png" alt="AARP Media Advertising Network"></a>
            </div>
            <nav class="flex-1 w-auto z-20">
                <menu class="flex justify-end">
                    <li class="block relative dropdown-trigger group">
                        <a class="block text-lg font-semibold group-hover:text-red duration-200" href="#">Our Network
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                        </a>
                        <div class="dropdown-menu absolute px-4 py-8" x-cloak>
                            <ul class="border-l border-gray-400 pr-12">
                                {% for heroOurNetworkSec in entry.headerOurNetworkDetails|default([]) %}
                                    {% set link = heroOurNetworkSec.headerOurNetworkLinks %}
                                    {% if link and link.id != entry.id %}
                                        <li class="block pb-2">
                                            <a href="{{ link.url }}" {% if link.target %}target="{{ link.target }}"{% endif %} class="block text-gray-800 whitespace-nowrap px-4 hover:text-red duration-200 font-semibold">{{ heroOurNetworkSec.headerOurNetworkText }}</a>
                                        </li>
                                    {% endif %}
                                {% endfor %}
                            </ul>
                            <ul class="border-l border-gray-400 pr-12">
                                {% for heroOurNetworkSecnSec in entry.headerOurNetworkSecDetails|default([]) %}
                                    <li class="block pb-2">
                                        <a class="block text-gray-800 whitespace-nowrap px-4 hover:text-red duration-200" href="{{ heroOurNetworkSecnSec.headerOurNetworkLinks }}">{{ heroOurNetworkSecnSec.headerOurNetworkSecText }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                            <ul class="border-l border-gray-400 pr-12">
                                {% for heroOurNetworkThirdSec in entry.headerOurNetworkThirdDetails|default([]) %}
                                    <li class="block pb-2">
                                        <a class="block text-gray-800 whitespace-nowrap px-4 hover:text-red duration-200" href="{{ heroOurNetworkThirdSec.headerOurNetworkLinks }}">{{ heroOurNetworkThirdSec.headerOurNetworkThirdText }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </li>
                    <li class="block group">
                    <a class="block text-lg font-semibold group-hover:text-red duration-200" href="/50-insights">50+ Insights</a></li><li class="block group">
                    <a class="block text-lg font-semibold group-hover:text-red duration-200" href="/aarp-advertising-rates/the-magazine">Rates &amp; Dates</a></li><li class="block group">
                    <a class="block text-lg font-semibold group-hover:text-red duration-200" href="/aarp-media/digital/ad-specs">Digital Specs</a></li>
                </menu>
            </nav>
            <div class="px-4 flex-shrink-0 w-auto buttons flex items-center z-20">
                <div class="relative">
                    <button class="search-button inline-flex items-center justify-center bg-transparent rounded-full w-[40px] h-[40px] border duration-200 lg:ml-6">
                        <span class="inline-block">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-[18px] h-[18px]">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                            </svg>
                        </span>
                    </button>
                    <form class="search-form" method="get" autocomplete="off" action="https://advertise.aarp.org/search" role="search">
                        <span class="absolute inline-flex items-center justify-center ext-red rounded-full border-white border-2 w-[36px] h-[36px]">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-[18px] h-[18px]">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                            </svg>
                        </span>
                        <input type="text" id="search" class="w-full border-0 md:text-xl" name="keywords" placeholder="Search" autocomplete="off">
                        <button type="button" class="search-close text-red absolute top-0 right-0 py-3 px-3">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </form>
                </div>
                <a href="https://advertise.aarp.org/contact" class="contact-button inline-flex items-center bg-red text-white rounded-full p-2 hover:bg-black duration-200 ml-6">
                    <span class="inline-block ml-4">Contact Us</span>
                    <span class="inline-block bg-white text-red p-1 rounded-full ml-4 lg:ml-8">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                        </svg>
                    </span>
                </a>
            </div>
        </div>
        <div class="mobile-dropdown-menu-container" x-data="{ secondLevel: false }">
            <div class="mobile-dropdown-menu flex flex-col-reverse justify-between items-start animatable" :class="mobileMenuOpen ? 'active' : ''">
                <div class="pb-28">
                    <a href="/contact" class="mobile-contact-button inline-flex items-center bg-red text-white rounded-full p-2 hover:bg-black duration-200">
                        <span class="inline-block ml-4">Contact Us</span>
                        <span class="inline-block bg-white text-red p-1 rounded-full ml-4">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
                                </svg>
                            </span>
                    </a>
                </div>
                <div class="h-full w-full">
                    <span class="mobile-back-button" :class="secondLevel ? 'visible' : 'invisible'" @click="secondLevel = false">
                            <span class="icon">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
                                </svg>
                            </span>
                    <span>Back</span>
                    </span>
                    <menu class="top-level mb-8" x-show="!secondLevel">
                        <li class="relative">
                            <span class="mobile-network-button block" @click="secondLevel = true">
                            Our Network
                                <span class="block absolute top-2 right-8">	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
                                </svg>
                                </span>
                            </span>
                        </li>
                        <li><a href="/50-insights">50+ Insights</a></li>
                        <li><a href="/aarp-advertising-rates/the-magazine">Rates &amp; Dates</a></li>
                        <li><a href="/aarp-media/digital/ad-specs">Digital Specs</a></li>
                    </menu>
                    <menu class="second-level mb-8" x-show="secondLevel" style="display: none;">
                        <li><span class="!text-black text-lg font-semibold">Our Network</span></li>

                        {% for heroOurNetworkSec in entry.headerOurNetworkDetails|default([]) %}
                            {% set link = heroOurNetworkSec.headerOurNetworkLinks %}
                            {% if link and link.id != entry.id %}
                                <li>
                                    <a href="{{ link.url }}" {% if link.target %} target="{{ link.target }}"{% endif %}>{{ heroOurNetworkSec.headerOurNetworkText }}</a>
                                </li>
                            {% endif %}
                        {% endfor %}

                        {% for heroOurNetworkSecnSec in entry.headerOurNetworkSecDetails|default([]) %}
                            <li>
                                <a href="{{ heroOurNetworkSecnSec.headerOurNetworkLinks }}">{{ heroOurNetworkSecnSec.headerOurNetworkSecText }}</a>
                            </li>
                        {% endfor %}

                        {% for heroOurNetworkThirdSec in entry.headerOurNetworkThirdDetails|default([]) %}
                            <li>
                                <a href="{{ heroOurNetworkThirdSec.headerOurNetworkLinks }}">{{ heroOurNetworkThirdSec.headerOurNetworkThirdText }}</a>
                            </li>
                        {% endfor %}
                    </menu>
                </div>
            </div>
    </div>
    </div>
</header>

<!-- Download Our Network -->
<a href="https://advertise.aarp.org/uploads/misc/AMAN-Static-Network-Placemat_1.8.26.pdf" class="download-link bg-red hover:bg-black text-white" target="_new">
    <img class="w-5 md:w-auto" src="https://advertise.aarp.org/assets/img/pdf.svg" alt="PDF Icon">
    <span>Download Our Network</span>
    <span class="inline-block bg-white text-red p-1 rounded-full ml-4">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 15.75L3 12m0 0l3.75-3.75M3 12h18" />
        </svg>
    </span>
</a>

<main class="flex-auto bg-gradient">
    <!-- Hero Section -->
    <section class="bg-gradient pb-8 pt-28 md:pt-48">
        <div class="mx-auto max-w-7xl">
            {% for heroSec in entry.heroDetails|default([]) %}
                <div class="px-4 mx-auto md-prose text-center max-w-5xl">
                    <h1><span class="text-red">{{ heroSec.heroTitle }}</span><br/><strong>{{ heroSec.heroSubheading }}</strong></h1>
                </div>
                <div class="px-4 mx-auto md-prose text-center max-w-4xl pb-12">
                    <p>{{ heroSec.heroSubtext|raw }}</p>
                </div>
            {% endfor %}

            <!-- Advertising Market -->
            <div class="flex flex-wrap justify-center px-2 pb-12">
                <div class="px-2 w-full md:w-1/3 mb-10">
                    <a href="https://advertise.aarp.org/aarp-media/the-magazine" target="_blank" class="block overflow-hidden rounded-3xl mb-4">
                        <img class="hover:scale-110 duration-300" src="https://advertise.aarp.org/assets/i/miscellaneous/189050/OMK-Tiles_ATM-wArc_Drew_8fc0bddcd3f772db468d33181a9fb79c.png" alt="OMK Tiles ATM w Arc Drew">
                    </a>
                    <a href="https://advertise.aarp.org/aarp-media/the-magazine" class="h3 pr-4">AARP The Magazine</a></div>
                <div class="px-2 w-full md:w-1/3 mb-10">
                    <a href="https://advertise.aarp.org/aarp-media/the-bulletin" target="_blank" class="block overflow-hidden rounded-3xl mb-4">
                        <img class="hover:scale-110 duration-300" src="https://advertise.aarp.org/assets/i/miscellaneous/1935/OMK-Tiles_AB-wArc_8fc0bddcd3f772db468d33181a9fb79c.jpg" alt="OMK Tiles AB w Arc">
                    </a>
                    <a href="https://advertise.aarp.org/aarp-media/the-bulletin" class="h3 pr-4">AARP Bulletin</a></div>
                <div class="px-2 w-full md:w-1/3 mb-10">
                    <a href="https://advertise.aarp.org/aarp-media/aarp" target="_blank" class="block overflow-hidden rounded-3xl mb-4">
                        <img class="hover:scale-110 duration-300" src="https://advertise.aarp.org/assets/i/miscellaneous/1936/OMK-Tiles_AARPdotORG-wArc_8fc0bddcd3f772db468d33181a9fb79c.jpg" alt="OMK Tiles AAR Pdot ORG w Arc">
                    </a>
                    <a href="https://advertise.aarp.org/aarp-media/aarp" class="h3 pr-4">AARP.org</a></div>
            </div>

            <!-- Mid Market -->
            <div class="flex flex-wrap justify-center px-2 pb-12">
                <div class="px-2 w-1/2 md:w-1/4 mb-10">
                    <a href="https://advertise.aarp.org/aarp-media/special-publications" target="_blank" class="block overflow-hidden rounded-3xl mb-4">
                        <img class="hover:scale-110 transition-all duration-300" src="https://advertise.aarp.org/assets/i/miscellaneous/1938/OMK-Tiles_SpecialPubs_R1-wArc_8fc0bddcd3f772db468d33181a9fb79c.png" alt="OMK Tiles Special Pubs w Arc">
                    </a>
                    <a href="https://advertise.aarp.org/aarp-media/special-publications" class="h3 pr-4">Special Publications</a></div>
                <div class="px-2 w-1/2 md:w-1/4 mb-10">
                    <a href="https://advertise.aarp.org/aarp-media/native" target="_blank" class="block overflow-hidden rounded-3xl mb-4">
                        <img class="hover:scale-110 transition-all duration-300" src="https://advertise.aarp.org/assets/i/miscellaneous/1939/OMK-Tiles_Native-wArc_8fc0bddcd3f772db468d33181a9fb79c.jpg" alt="OMK Tiles Native w Arc">
                    </a>
                    <a href="https://advertise.aarp.org/aarp-media/native" class="h3 pr-4">Native</a></div>
                <div class="px-2 w-1/2 md:w-1/4 mb-10">
                    <a href="https://advertise.aarp.org/aarp-media/sponsorships" target="_blank" class="block overflow-hidden rounded-3xl mb-4">
                        <img class="hover:scale-110 transition-all duration-300" src="https://advertise.aarp.org/assets/i/miscellaneous/1940/OMK-Tiles_Sponsorship-wArc_R1_8fc0bddcd3f772db468d33181a9fb79c.png" alt="OMK Tiles Sponsorship w Arc">
                    </a>
                    <a href="https://advertise.aarp.org/aarp-media/sponsorships" class="h3 pr-4">Sponsorships</a></div>
                <div class="px-2 w-1/2 md:w-1/4 mb-10">
                    <a href="https://advertise.aarp.org/aarp-media/newsletters" target="_blank" class="block overflow-hidden rounded-3xl mb-4">
                        <img class="hover:scale-110 transition-all duration-300" src="https://advertise.aarp.org/assets/i/miscellaneous/1941/OMK-Tiles_Newsletters_R1-wArc_8fc0bddcd3f772db468d33181a9fb79c.jpg" alt="OMK Tiles Newsletters R1 w Arc">
                    </a>
                    <a href="https://advertise.aarp.org/aarp-media/newsletters" class="h3 pr-4">Newsletters</a></div>
                <div class="px-2 w-1/2 md:w-1/4 mb-10">
                    <a href="https://advertise.aarp.org/aarp-media/first-party-data" target="_blank" class="block overflow-hidden rounded-3xl mb-4">
                        <img class="hover:scale-110 transition-all duration-300" src="https://advertise.aarp.org/assets/i/miscellaneous/1946/OMK-Tiles_FirstPartyData-wArc_8fc0bddcd3f772db468d33181a9fb79c.jpg" alt="OMK Tiles First Party Data w Arc">
                    </a>
                    <a href="https://advertise.aarp.org/aarp-media/first-party-data" class="h3 pr-4">First-Party Data Targeting</a></div>
                <div class="px-2 w-1/2 md:w-1/4 mb-10">
                    <a href="https://advertise.aarp.org/aarp-media/video" target="_blank" class="block overflow-hidden rounded-3xl mb-4">
                        <img class="hover:scale-110 transition-all duration-300" src="https://advertise.aarp.org/assets/i/miscellaneous/1947/OMK-Tiles_Video-R2-wArc_8fc0bddcd3f772db468d33181a9fb79c.jpg" alt="OMK Tiles Video R2 w Arc">
                    </a>
                    <a href="https://advertise.aarp.org/aarp-media/video" class="h3 pr-4">Video</a></div>
                <div class="px-2 w-1/2 md:w-1/4 mb-10">
                    <a href="https://advertise.aarp.org/aarp-media/mobile-app" target="_blank" class="block overflow-hidden rounded-3xl mb-4">
                        <img class="hover:scale-110 transition-all duration-300" src="https://advertise.aarp.org/assets/i/miscellaneous/1948/OMK-Tiles_MobileApp-wArc_8fc0bddcd3f772db468d33181a9fb79c.jpg" alt="OMK Tiles Mobile App w Arc">
                    </a>
                    <a href="https://advertise.aarp.org/aarp-media/mobile-app" class="h3 pr-4">Mobile App</a></div>
            </div>
        </div>
    </section>
    <section class="bg-gradient pt-12 md:pt-24">
        <div class="mx-auto max-w-5xl">
            <div class="flex flex-wrap pb-4 ">
                <div class="w-full md:w-5/12 px-2">
                    <div class="overflow-hidden rounded-3xl mb-4 md:mb-0">
                        <img src="https://advertise.aarp.org/assets/i/miscellaneous/2257/Friends_Birthday_8fc0bddcd3f772db468d33181a9fb79c.jpg" alt="Friends Birthday"></div>
                </div>
                <div class="w-full md:w-7/12 px-2">
                    <div class="border border-red-wine rounded-3xl h-full px-12 pt-12 md-prose">
                        <h2 class="!text-red-wine max-w-xs pb-4 border-b border-red-wine !mb-6">Right Time.</h2>
                        <p>When adults 50+ join AARP, they are embracing their new life stage and seeking the support they immediately receive from AARP’s media channels – an instant bond that results in industry-leading engagement and <span class="text-red">high receptivity to brands that meet members’ needs</span>.</p>
                    </div>
                </div>
            </div>
            <div class="flex flex-wrap pb-4 md:flex-row-reverse">
                <div class="w-full md:w-5/12 px-2">
                    <div class="overflow-hidden rounded-3xl mb-4 md:mb-0">
                        <img src="https://advertise.aarp.org/assets/i/miscellaneous/2258/Couple_Boating_8fc0bddcd3f772db468d33181a9fb79c.jpg" alt="Couple Boating"></div>
                </div>
                <div class="w-full md:w-7/12 px-2">
                    <div class="border border-red rounded-3xl h-full px-12 pt-12 md-prose">
                        <h2 class="!text-red max-w-xs pb-4 border-b border-red !mb-6">Right Audience.</h2>
                        <p>AARP members are <span class="text-red">highly motivated</span> to live their best lives and financially empowered to do so – an audience ideally positioned to buy new products and services and massive enough to <span class="text-red">change your business</span>.</p>
                    </div>
                </div>
            </div>
            <div class="flex flex-wrap pb-4 ">
                <div class="w-full md:w-5/12 px-2">
                    <div class="overflow-hidden rounded-3xl mb-4 md:mb-0">
                        <img src="https://advertise.aarp.org/assets/i/miscellaneous/2259/Couple_Tablet_8fc0bddcd3f772db468d33181a9fb79c.jpg" alt="Couple Tablet"></div>
                </div>
                <div class="w-full md:w-7/12 px-2">
                    <div class="border border-gray rounded-3xl h-full px-12 pt-12 md-prose">
                        <h2 class="!text-gray max-w-xs pb-4 border-b border-gray !mb-6">Right Brand.</h2>
                        <p><span class="block text-red text-8xl">91<sup class="text-5xl">%<sup></sup></sup></span></p>
                        <p>of members <span class="text-red">trust AARP Media more</span> than other media. Unmatched trust in the AARP brand translates to <span class="text-red">increased brand consideration and consumer action</span> for advertisers.</p>
                    </div>
                </div>
            </div>
            <div class="flex flex-wrap pb-4">
                <div class="w-full px-2">
                    {% for advNetworkblock in entry.mediaAdvertisingNetworkDetails|default([]) %}
                        <div class="bg-white rounded-3xl pl-12 pr-10 pt-10 pb-4">
                            <h2 class="h2 !text-red">{{ advNetworkblock.mediaAdvertisingNetworkHeading }}</h2>
                            <div class="flex flex-wrap items-center">
                                <div class="w-full md:flex-1 md:w-auto md-prose">
                                    <p>{{ advNetworkblock.mediaAdvertisingNetworkText }}</p>
                                </div>
                                <div class="w-full md:flex-shrink-0 md:w-auto mb-8 px-8">
                                    <a href="{{ advNetworkblock.mediaAdvertisingNetworkReachLink }}" class="inline-flex items-center bg-red text-white rounded-full p-2 hover:bg-black duration-200">
                                        <span class="inline-block ml-4">{{ advNetworkblock.mediaAdvertisingNetworkReachText }}</span>
                                        <span class="inline-block bg-white text-red p-1 rounded-full ml-4 lg:ml-16">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"></path>
        </svg></span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
    <img class="w-full object-cover max-h-[850px]" src="https://advertise.aarp.org/uploads/footer-image.jpg" alt="Footer Image">
</main>

<footer class="main-footer bg-red py-16">
    <div class="mx-auto max-w-7xl flex flex-wrap">
        <div class="px-8 md:px-4 w-full flex items-center mb-8 md:w-1/2 lg:w-7/12">
            {% for redFooterImageSec in entry.redFooterImageDetails|default([]) %}
                {% set image = redFooterImageSec.redFooterAarpImage.one() %}
                {% if image %}
                    <a href="{{ redFooterImageSec.redFooterImageLink }}" class="block">
                        <img src="{{ image.url }}" alt="{{ redFooterImageSec.redFooterAltText }}">
                    </a>
                {% endif %}
            {% endfor %}
        </div>
        <div class="px-8 md:px-4 w-full md:w-1/2 lg:w-5/12 flex flex-wrap md:flex-nowrap text-white">
            <menu class="w-full md:w-1/2 md:ml-12 pl-4 md:pl-8 border-l border-white/40 mb-8">
                <li class="block"><span>Core Media Properties</span></li>
                {% for redFooterSec in entry.redFooterDetails|default([]) %}
                    <li class="block">
                        <a class="duration-200 hover:opacity-50" href="{{ redFooterSec.redFooterLinks }}">{{ redFooterSec.redFooterText }}</a>
                    </li>
                {% endfor %}
            </menu>
            <menu class="w-full md:w-1/2 md:ml-12 pl-4 md:pl-8 border-l border-white/40">
                {% for redSecFooterSec in entry.redFooterSecondDetails|default([]) %}
                    <li class="block">
                        <a class="duration-200 hover:opacity-50" href="{{ redSecFooterSec.redFooterSecondLinks }}">{{ redSecFooterSec.redFooterSecondText }}</a>
                    </li>
                {% endfor %}
            </menu>
        </div>
    </div>
</footer>

<!-- Cookie Banner -->
<div class="cookie-banner bg-green-banner fixed bottom-0 left-0 right-0 py-8">
    {% for footerSec in entry.stickyFooterFields|default([]) %}
        <div class="mx-auto w-full max-w-7xl px-4">
            <h2 class="text-lg mb-2 font-semibold">{{ footerSec.stickyFooterHeader }}</h2>
            <p class="mb-4">{{ footerSec.stickyFooterSubtext }}</p>
            <button class="cookie-banner-close bg-red text-white rounded-full px-12 py-2 hover:bg-black duration-200">{{ footerSec.stickyFooterButton }}</button>
        </div>
    {% endfor %}
</div>

